# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/akatsukis-draft
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/akatsukis-draft?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=akatsukis_draft_jwt_secret_key_2026_secure

# Google Gemini AI API Configuration
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

